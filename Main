local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DivergentFistGUI"
ScreenGui.ResetOnSpawn = false
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("Frame")
Frame.Name = "DFContainer"
Frame.Size = UDim2.fromOffset(80, 80)
Frame.Position = UDim2.new(0.85, 0, 0.08, 0)
Frame.AnchorPoint = Vector2.new(0.5, 0.5)
Frame.BackgroundTransparency = 1
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = Frame

local ImageButton = Instance.new("ImageButton")
ImageButton.Size = UDim2.new(1, 0, 1, 0)
ImageButton.Position = UDim2.new(0, 0, 0, 0)
ImageButton.BackgroundTransparency = 1
ImageButton.Image = "rbxassetid://122912702738362"
ImageButton.ImageTransparency = 0.16
ImageButton.ScaleType = Enum.ScaleType.Fit
ImageButton.AutoButtonColor = false
ImageButton.Parent = Frame

local UICorner2 = Instance.new("UICorner")
UICorner2.CornerRadius = UDim.new(1, 0)
UICorner2.Parent = ImageButton

local TextButton = Instance.new("TextButton")
TextButton.Size = UDim2.fromOffset(28, 28)
TextButton.Position = UDim2.new(1, -34, 0, 6)
TextButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
TextButton.Text = "ðx\29\25"
TextButton.TextScaled = true
TextButton.Font = Enum.Font.GothamBold
TextButton.TextColor3 = Color3.new(1, 1, 1)
TextButton.Parent = ScreenGui

TextButton.MouseButton1Click:Connect(function()
	TextButton.Text = "ðx\29\25"
	TextButton.BackgroundColor3 = Color3.fromRGB(70, 30, 30)
end)

TextButton.Text = "ðx\29\28"
TextButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)

ImageButton.InputBegan:Connect(function(input, gameProcessed)
end)

UserInputService.InputChanged:Connect(function(input2, gameProcessed2)
end)

UserInputService.InputEnded:Connect(function(input3, gameProcessed3)
end)

TweenService:Create(ImageButton, TweenInfo.new(0.08), { ImageColor3 = Color3.new(0, 0, 0) })
TweenService:Create(ImageButton, TweenInfo.new(0.08), { ImageColor3 = Color3.new(1, 1, 1) })

ImageButton.InputBegan:Connect(function(input4, gameProcessed4)
end)

ImageButton.InputEnded:Connect(function(input5, gameProcessed5)
end)

ImageButton.MouseButton1Click:Connect(function()
	Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local players = Players:GetPlayers()
	for k, v in pairs(players) do
		v.Character:FindFirstChild("HumanoidRootPart")
		v.Character:FindFirstChild("Humanoid")
	end
	
	local descendants = workspace:GetDescendants()
	local v2 = nil
	for k2, v2_item in pairs(descendants) do
		if v2_item:FindFirstChild("Humanoid") and v2_item:FindFirstChild("HumanoidRootPart") then
			v2 = v2_item
			break
		end
	end
	
	if v2 and v2:FindFirstChild("HumanoidRootPart") then
		print("Target found:", v2.HumanoidRootPart.Parent.Name)
	end
	
	local Moveset = Players.LocalPlayer.Character:FindFirstChild("Moveset")
	local DivergentFist = Moveset:FindFirstChild("Divergent Fist")
	local Knit = ReplicatedStorage:FindFirstChild("Knit")
	local Knit2 = Knit:FindFirstChild("Knit")
	local Services = Knit2:FindFirstChild("Services")
	local DivergentFistService = Services:FindFirstChild("DivergentFistService")
	local RE = DivergentFistService:FindFirstChild("RE")
	local Activated = RE:FindFirstChild("Activated")
	
	spawn(function(...)
		if v2 and v2:FindFirstChild("HumanoidRootPart") then
			Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			Players.LocalPlayer.Character:FindFirstChild("Humanoid")
			((v2.HumanoidRootPart.Position + (v2.HumanoidRootPart.CFrame.LookVector * -5)) - Players.LocalPlayer.Character.HumanoidRootPart.Position).Unit:Cross(Vector3.new(0, 1, 0))
			v2.HumanoidRootPart.CFrame.LookVector:Cross((Players.LocalPlayer.Character.HumanoidRootPart.Position - v2.HumanoidRootPart.Position).Unit)
		end
	end)
	
	Activated:FireServer(DivergentFist)
	print("FIRED HIT 1")
	task.wait(0.33)
	Activated:FireServer(DivergentFist)
	print("FIRED HIT 2 (0.33s after hit 1)")
end)
