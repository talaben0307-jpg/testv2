chipRow(SKILL_KEYS,
    function(k) return S.Skills[k] end,
    function(k, v) S.Skills[k] = v end)
numRow("Độ trễ skill (giây)", S.SkillDelay, function(v) S.SkillDelay = math.clamp(v, 0.2, 10) end)

section("Di chuyển và An toàn")
numRow("Độ cao trên mob", S.Height, function(v) S.Height = math.clamp(v, 0, 40) end)
numRow("Tốc độ bay", S.Speed, function(v) S.Speed = math.clamp(v, 50, 600) end)
toggleRow("Noclip", function() return S.Noclip end, function(v) S.Noclip = v end)
toggleRow("Tự lùi khi máu thấp", function() return S.AutoRetreat end, function(v) S.AutoRetreat = v end)

statusLabel = mk("TextLabel", {
    Parent = Main,
    AnchorPoint = Vector2.new(0, 1),
    Position = UDim2.new(0, 12, 1, -8),
    Size = UDim2.new(1, -24, 0, 20),
    BackgroundTransparency = 1,
    Font = Enum.Font.Gotham,
    Text = "Sẵn sàng (Bấm F ẩn/hiện menu)",
    TextSize = 11,
    TextColor3 = SUB,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextTruncate = Enum.TextTruncate.AtEnd,
})

track(UserInputService.InputBegan:Connect(function(i, gp)
    if not gp and i.KeyCode == Enum.KeyCode.F then
        Main.Visible = not Main.Visible
    end
end))

env.BFFarmCleanup = function()
    S.Enabled = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    pcall(function() Gui:Destroy() end)
    env.BFFarmCleanup = nil
end
close.MouseButton1Click:Connect(function()
    if env.BFFarmCleanup then env.BFFarmCleanup() end
end)

renderFarm()
rebuildMobList()
