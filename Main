local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("DivergentFistGUI") then
	PlayerGui.DivergentFistGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DivergentFistGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local MainButton = Instance.new("TextButton")
MainButton.Size = UDim2.fromOffset(130, 50)
MainButton.Position = UDim2.new(0.75, 0, 0.15, 0)
MainButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
MainButton.Text = "DIVERGENT FIST"
MainButton.TextScaled = true
MainButton.Font = Enum.Font.GothamBold
MainButton.TextColor3 = Color3.new(1, 1, 1)
MainButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainButton

local dragging, dragStart, startPos
MainButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainButton.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

MainButton.MouseButton1Click:Connect(function()
	pcall(function()
		local character = LocalPlayer.Character
		if not character then return end
		
		local Moveset = character:FindFirstChild("Moveset")
		local DivergentFist = Moveset and Moveset:FindFirstChild("Divergent Fist")
		
		local Knit = ReplicatedStorage:FindFirstChild("Knit")
		local Knit2 = Knit and Knit:FindFirstChild("Knit")
		local Services = Knit2 and Knit2:FindFirstChild("Services")
		local DivergentFistService = Services and Services:FindFirstChild("DivergentFistService")
		local RE = DivergentFistService and DivergentFistService:FindFirstChild("RE")
		local Activated = RE and RE:FindFirstChild("Activated")
		
		if Activated and DivergentFist then
			Activated:FireServer(DivergentFist)
			task.wait(0.33)
			Activated:FireServer(DivergentFist)
		end
	end)
end)
