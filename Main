local mobRows = {}
local function renderSelection()
    selLabel.Text = S.MobName and ("Đang chọn: " .. S.MobName) or "Chưa chọn"
    for _, r in ipairs(mobRows) do
        local on = (r.name ~= nil and r.name == S.MobName)
        r.btn.BackgroundColor3 = on and ACCDIM or BG
        r.btn.TextColor3 = on and ACC or TXT
    end
end

local function rebuildMobList()
    for _, r in ipairs(mobRows) do r.btn:Destroy() end
    table.clear(mobRows)
    local mobs = scanAllSea1Mobs()
    for i, m in ipairs(mobs) do
        local b = mk("TextButton", {
            Parent = MobList,
            LayoutOrder = i,
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = BG,
            Font = Enum.Font.Gotham,
            Text = string.format("  ⚔️ %s  (Có: %d)", m.name, m.count),
            TextSize = 12,
            TextColor3 = TXT,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
        }, { round(6) })
        
        b.MouseButton1Click:Connect(function()
            S.MobName = (S.MobName == m.name) and nil or m.name
            target = nil
            renderSelection()
            if S.MobName then
                triggerAcceptQuest(S.MobName)
                setStatus("Đã chọn mob & nhận quest: " .. S.MobName)
            end
        end)
        table.insert(mobRows, { btn = b, name = m.name })
    end
    renderSelection()
end

refreshBtn.MouseButton1Click:Connect(function()
    rebuildMobList()
    setStatus("Đã làm mới danh sách mob")
end)

