--[[
    Blox Fruits - Auto Farm v7 (Chuẩn Redz Fast Attack - Đánh lập tức không cooldown)
    Phím F: ẩn/hiện menu
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

local env = (getgenv and getgenv()) or _G
if env.BFFarmCleanup then pcall(env.BFFarmCleanup) end

local conns = {}
local function track(c) table.insert(conns, c) return c end

local SEA1_ISLANDS = {
    { Name = "Đảo Khởi Đầu (Bandit)", Pos = Vector3.new(1071, 16, 1341), Mobs = { "Bandit" } },
    { Name = "Đảo Khỉ (Monkey/Gorilla)", Pos = Vector3.new(-1249, 11, 3813), Mobs = { "Monkey", "Gorilla", "Gorilla King" } },
    { Name = "Đảo Cướp Biển (Pirate/Brute)", Pos = Vector3.new(-1139, 4, 4398), Mobs = { "Pirate", "Brute", "Bobby", "The Saw" } },
    { Name = "Sa Mạc (Desert)", Pos = Vector3.new(895, 6, 4389), Mobs = { "Desert Bandit", "Desert Officer" } },
    { Name = "Đảo Tuyết (Snow)", Pos = Vector3.new(1389, 87, -1298), Mobs = { "Snow Bandit", "Snowman", "Yeti" } },
    { Name = "Marine Ford (Navy)", Pos = Vector3.new(-4881, 20, 4307), Mobs = { "Chief Petty Officer", "Navy Chief", "Greybeard" } },
    { Name = "Bầu Trời (Sky Islands)", Pos = Vector3.new(-4842, 717, -2623), Mobs = { "Sky Bandit", "Dark Master", "God's Guard", "Thunder God" } },
    { Name = "Đảo Nhà Tù (Prison)", Pos = Vector3.new(4875, 5, 739), Mobs = { "Prisoner", "Dangerous Prisoner", "Chief Warden", "Swan" } },
    { Name = "Đấu Trường (Colosseum)", Pos = Vector3.new(-1311, 7, -2976), Mobs = { "Toga Warrior", "Gladiator" } },
    { Name = "Magma Village (Dung Nham)", Pos = Vector3.new(-5316, 12, 8515), Mobs = { "Military Soldier", "Military Spy", "Magma Admiral" } },
    { Name = "Thủy Sái (Underwater City)", Pos = Vector3.new(6112, 5, 1567), Mobs = { "Fishman Warrior", "Fishman Commando", "Fishman Lord" } }
}

local WEAPON_TYPES = { "Melee", "Sword", "Gun", "Blox Fruit" }
local SKILL_KEYS = { "Z", "X", "C", "V" }

local S = {
    Enabled = false,
    MobName = nil,
    AutoQuest = true,
    Weapons = { ["Melee"] = true, ["Sword"] = false, ["Gun"] = false, ["Blox Fruit"] = false },
    SwitchInterval = 6,
    Skills = { Z = false, X = false, C = false, V = false },
    SkillDelay = 1.2,
    Height = 6,
    Speed = 300,
    Range = 5000,
    AttackRange = 80,
    FastAttack = true,       -- Bật Fast Attack chuẩn Redz
    BringMobs = true,        -- Gom quái xuống dưới chân
    Noclip = true,
    RetreatBelow = 35,
    ResumeAbove = 80,
    RetreatHeight = 120,
    AutoRetreat = true,
}

local function isPlayerModel(m)
    return Players:GetPlayerFromCharacter(m) ~= nil
end

local function forEachNpcModel(fn)
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        for _, m in ipairs(enemies:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and not isPlayerModel(m) then
                fn(m)
            end
        end
    else
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local m = d.Parent
                if m and m:IsA("Model") and not isPlayerModel(m) then fn(m) end
            end
        end
    end
end

local function scanAllSea1Mobs()
    local counts = {}
    forEachNpcModel(function(m)
        counts[m.Name] = (counts[m.Name] or 0) + 1
    end)
    for _, island in ipairs(SEA1_ISLANDS) do
        for _, mobName in ipairs(island.Mobs) do
            if not counts[mobName] then counts[mobName] = 0 end
        end
    end
    local list = {}
    for name, n in pairs(counts) do
        table.insert(list, { name = name, count = n })
    end
    table.sort(list, function(a, b) return a.name < b.name end)
    return list
end

local function isAliveModel(m)
    local hum = m:FindFirstChildOfClass("Humanoid")
    local hrp = m:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and hrp ~= nil and hum.Health > 0
end

local function findTarget(myPos)
    local best, bestDist = nil, S.Range
    forEachNpcModel(function(m)
        if S.MobName and m.Name ~= S.MobName then return end
        if isAliveModel(m) then
            local d = (m.HumanoidRootPart.Position - myPos).Magnitude
            if d < bestDist then best, bestDist = m, d end
        end
    end)
    return best
end

local function teleportToPosition(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 10, 0))
    end
end

local function hasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local mainGui = playerGui:FindFirstChild("Main")
        if mainGui then
            local questFrame = mainGui:FindFirstChild("Quest")
            if questFrame and questFrame.Visible then
                return true
            end
        end
    end
    return false
end

local function triggerAcceptQuest(mobName)
    if not mobName then return end
    local targetIsland = nil
    for _, island in ipairs(SEA1_ISLANDS) do
        for _, m in ipairs(island.Mobs) do
            if m == mobName then targetIsland = island break end
        end
        if targetIsland then break end
    end
    if targetIsland then
        teleportToPosition(targetIsland.Pos)
        task.wait(0.5)
        pcall(function()
            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", mobName)
        end)
    end
end

local weaponIdx = 1
local lastSwitch = os.clock()

local function enabledWeapons()
    local list = {}
    for _, w in ipairs(WEAPON_TYPES) do
        if S.Weapons[w] then table.insert(list, w) end
    end
    if #list == 0 then list[1] = "Melee" end
    return list
end

local function currentWeaponType()
    local list = enabledWeapons()
    if weaponIdx > #list then weaponIdx = 1 end
    return list[weaponIdx]
end

local function findWeapon(wtype)
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and t.ToolTip == wtype then return t end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == wtype then return t end
        end
    end
    return nil
end

local function equipWeapon(wtype)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = findWeapon(wtype)
    if tool and hum and tool.Parent ~= char then
        hum:EquipTool(tool)
    end
    return tool
end

local skillIdx = 0
local lastSkill = 0

local function pressKey(name)
    local code = Enum.KeyCode[name]
    pcall(function() VirtualInputManager:SendKeyEvent(true, code, false, game) end)
    task.delay(0.06, function()
        pcall(function() VirtualInputManager:SendKeyEvent(false, code, false, game) end)
    end)
end

local function nextSkill()
    for _ = 1, #SKILL_KEYS do
        skillIdx = skillIdx % #SKILL_KEYS + 1
        local k = SKILL_KEYS[skillIdx]
        if S.Skills[k] then return k end
    end
    return nil
end

-- === FAST ATTACK CHUẨN REDZ (Gây sát thương tức thì không cooldown, gom quái ngay dưới chân) ===
local function redzFastAttack(myPos)
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    
    if tool then
        pcall(function() tool:Activate() end)
    end

    forEachNpcModel(function(m)
        if S.MobName and m.Name ~= S.MobName then return end
        if isAliveModel(m) then
            local hrp = m:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myPos).Magnitude
                -- Nếu quái ở trong tầm đánh hoặc bán kính gom
                if dist <= 100 then
                    if S.BringMobs and dist > 3 then
                        -- Ép quái dính chặt ngay dưới chân người chơi
                        hrp.CFrame = CFrame.new(myPos + Vector3.new(0, 1, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    -- Kích hoạt đòn đánh liên tục không cooldown lên quái
                    pcall(function()
                        VirtualUser:Button1Down(Vector2.new(0, 0))
                        VirtualUser:Button1Up(Vector2.new(0, 0))
                    end)
                end
            end
        end
    end)
end

local target = nil
local lastStatus = ""
local statusLabel
local retreating = false
local retreatAnchor = nil

local function setStatus(t)
    if t ~= lastStatus and statusLabel then
        lastStatus = t
        statusLabel.Text = t
    end
end

local function moveToward(hrp, goal, speed, dt, lookAt)
    local diff = goal - hrp.Position
    local dist = diff.Magnitude
    local step = math.min(dist, speed * dt)
    local newPos = hrp.Position + (dist > 0.01 and diff.Unit or Vector3.zero) * step
    if lookAt then
        hrp.CFrame = CFrame.lookAt(newPos, lookAt)
    else
        hrp.CFrame = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return dist
end

track(RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if S.Enabled and S.Noclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end

    if not S.Enabled then return end
    if not (hum and hrp) or hum.Health <= 0 then
        target, retreating, retreatAnchor = nil, false, nil
        setStatus("Đang chờ hồi sinh...")
        return
    end

    if S.AutoQuest and S.MobName and not hasActiveQuest() then
        setStatus("Đang tự động nhận nhiệm vụ cho: " .. S.MobName)
        triggerAcceptQuest(S.MobName)
        task.wait(1)
        return
    end

    local hpPct = hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth * 100) or 100
    if S.AutoRetreat then
        if not retreating and hpPct < S.RetreatBelow then
            retreating = true
            retreatAnchor = hrp.Position + Vector3.new(0, S.RetreatHeight, 0)
        elseif retreating and hpPct >= S.ResumeAbove then
            retreating, retreatAnchor = false, nil
        end
    else
        retreating, retreatAnchor = false, nil
    end

    if retreating then
        moveToward(hrp, retreatAnchor, math.max(S.Speed, 200), dt, nil)
        setStatus(string.format("Máu thấp (%d%%), chờ hồi tới %d%%", hpPct, S.ResumeAbove))
        return
    end

    if not (target and target.Parent and isAliveModel(target)) then
        target = findTarget(hrp.Position)
    end
    
    if not target then
        setStatus(S.MobName and ("Đang tìm hoặc bay tới bãi: " .. S.MobName) or "Không thấy mob nào")
        return
    end

    local tHrp = target.HumanoidRootPart
    moveToward(hrp, tHrp.Position + Vector3.new(0, S.Height, 0), S.Speed, dt, tHrp.Position)

    local realDist = (tHrp.Position - hrp.Position).Magnitude
    setStatus(string.format("Farm & Fast Attack: %s (%d studs) · %s", target.Name, realDist, currentWeaponType()))

    -- Kích hoạt Fast Attack liên tục ở mọi khung hình (Frame) không cần chờ cooldown
    local list = enabledWeapons()
    if #list > 1 and (os.clock() - lastSwitch) >= S.SwitchInterval then
        lastSwitch = os.clock()
        weaponIdx = weaponIdx % #list + 1
    end
    equipWeapon(currentWeaponType())

    if S.FastAttack then
        redzFastAttack(hrp.Position)
    end

    -- Sử dụng Skill tự động theo vòng lặp
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool and (os.clock() - lastSkill) >= S.SkillDelay then
        local k = nextSkill()
        if k then
            lastSkill = os.clock()
            pressKey(k)
        end
    end
end))

track(LocalPlayer.Idled:Connect(function()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)
end))

track(LocalPlayer.CharacterAdded:Connect(function()
    target, retreating, retreatAnchor = nil, false, nil
end))

-- ===== Giao diện UI =====
local parentGui = (gethui and gethui()) or CoreGui
local Gui = Instance.new("ScreenGui")
Gui.Name = "BFFarmGuiV7"
Gui.ResetOnSpawn = false
Gui.Parent = parentGui

local BG = Color3.fromRGB(16, 16, 26)
local EL = Color3.fromRGB(30, 30, 46)
local ACC = Color3.fromRGB(0, 229, 255)
local ACCDIM = Color3.fromRGB(0, 96, 118)
local GOOD = Color3.fromRGB(70, 220, 130)
local TXT = Color3.fromRGB(240, 240, 248)
local SUB = Color3.fromRGB(150, 150, 176)

local function mk(class, props, kids)
    local i = Instance.new(class)
    if i:IsA("GuiObject") then i.BorderSizePixel = 0 end
    for k, v in pairs(props) do i[k] = v end
    for _, c in ipairs(kids or {}) do c.Parent = i end
    return i
end
local function round(r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }) end

local Main = mk("Frame", {
    Parent = Gui,
    Size = UDim2.fromOffset(340, 560),
    Position = UDim2.new(0, 50, 0.5, -280),
    BackgroundColor3 = BG,
}, { round(12), mk("UIStroke", { Color = ACC, Thickness = 1.5, Transparency = 0.3 }) })

local Title = mk("TextLabel", {
    Parent = Main,
    Size = UDim2.new(1, 0, 0, 36),
    BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold,
    Text = "Blox Fruits Farm v7 (Redz Fast Attack)",
    TextSize = 13,
    TextColor3 = ACC,
})

do
    local dragging, startIn, startPos = false, nil, nil
    Title.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startIn, startPos = true, i.Position, Main.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startIn
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

local close = mk("TextButton", {
    Parent = Main,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -8, 0, 6),
    Size = UDim2.fromOffset(24, 24),
    BackgroundColor3 = EL,
    Font = Enum.Font.GothamBold,
    Text = "✕",
    TextSize = 12,
    TextColor3 = TXT,
    AutoButtonColor = false,
}, { round(12) })

local Body = mk("ScrollingFrame", {
    Parent = Main,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 10, 0, 40),
    Size = UDim2.new(1, -20, 1, -72),
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = ACC,
}, {
    mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
    mk("UIPadding", { PaddingRight = UDim.new(0, 6) }),
})

local order = 0
local function row(h)
    order += 1
    return mk("Frame", {
        Parent = Body,
        LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, h),
        BackgroundColor3 = EL,
    }, { round(8) })
end

local function section(text)
    order += 1
    mk("TextLabel", {
        Parent = Body,
        LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = string.upper(text),
        TextSize = 11,
        TextColor3 = ACC,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
end

local function label(parent, text, w)
    return mk("TextLabel", {
        Parent = parent,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(w or 0.55, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = text,
        TextSize = 12,
        TextColor3 = TXT,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
end

local function numBox(parent, default, onChange)
    local box = mk("TextBox", {
        Parent = parent,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0.3, 0, 0, 24),
        BackgroundColor3 = BG,
        Font = Enum.Font.GothamBold,
        Text = tostring(default),
        TextSize = 12,
        TextColor3 = ACC,
        ClearTextOnFocus = false,
    }, { round(6) })
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then onChange(n) else box.Text = tostring(default) end
    end)
    return box
end

local function numRow(text, default, onChange)
    local r = row(34)
    label(r, text, 0.62)
    numBox(r, default, onChange)
end

local function toggleRow(text, get, set)
    local r = row(34)
    local b = mk("TextButton", {
        Parent = r,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = "",
        TextSize = 12,
        TextColor3 = TXT,
        AutoButtonColor = false,
    })
    local function render()
        b.Text = text .. ": " .. (get() and "BẬT" or "TẮT")
        b.TextColor3 = get() and GOOD or TXT
    end
    b.MouseButton1Click:Connect(function() set(not get()) render() end)
    render()
end

local function chipRow(names, isOn, setOn)
    local r = row(34)
    local n = #names
    local chips = {}
    local function render()
        for _, c in ipairs(chips) do
            local on = isOn(c.name)
            c.btn.BackgroundColor3 = on and ACCDIM or BG
            c.btn.TextColor3 = on and ACC or SUB
        end
    end
    for i, name in ipairs(names) do
        local btn = mk("TextButton", {
            Parent = r,
            Position = UDim2.new((i - 1) / n, 3, 0.5, -12),
            Size = UDim2.new(1 / n, -6, 0, 24),
            BackgroundColor3 = BG,
            Font = Enum.Font.GothamBold,
            Text = name,
            TextSize = 11,
            TextColor3 = SUB,
            AutoButtonColor = false,
        }, { round(6) })
        btn.MouseButton1Click:Connect(function()
            setOn(name, not isOn(name))
            render()
        end)
        table.insert(chips, { name = name, btn = btn })
    end
    render()
end

local farmRow = row(40)
local farmBtn = mk("TextButton", {
    Parent = farmRow,
    Size = UDim2.new(1, 0, 1, 0),
    BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold,
    Text = "",
    TextSize = 14,
    TextColor3 = SUB,
    AutoButtonColor = false,
})
local function renderFarm()
    farmBtn.Text = "AUTO FARM: " .. (S.Enabled and "BẬT" or "TẮT")
    farmBtn.TextColor3 = S.Enabled and GOOD or SUB
end
farmBtn.MouseButton1Click:Connect(function()
    S.Enabled = not S.Enabled
    if not S.Enabled then
        target, retreating, retreatAnchor = nil, false, nil
        setStatus("Đã tắt")
    end
    renderFarm()
end)

