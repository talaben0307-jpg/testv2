chipRow(WEAPON_TYPES,
    function(n) return S.Weapons[n] end,
    function(n, v)
        S.Weapons[n] = v
        weaponIdx = 1
    end)
numRow("Đổi vũ khí mỗi (giây)", S.SwitchInterval, function(v) S.SwitchInterval = math.clamp(v, 1, 60) end)

