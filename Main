--[[
    Blox Fruits - Auto Farm v9 (Redz Style: Đứng yên gom quái, Fast Attack độc lập, Tween TP)
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local env = (getgenv and getgenv()) or _G
if env.BFFarmCleanup then pcall(env.BFFarmCleanup) end

local conns = {}
local function track(c) table.insert(conns, c) return c end

local SEA1_ISLANDS = {
    { Name = "Lv. 1+ | Đảo Khởi Đầu", Pos = Vector3.new(1071, 16, 1341), Mobs = { "Bandit" } },
    { Name = "Lv. 10+ | Đảo Khỉ", Pos = Vector3.new(-1249, 11, 3813), Mobs = { "Monkey", "Gorilla", "Gorilla King" } },
    { Name = "Lv. 30+ | Đảo Cướp Biển", Pos = Vector3.new(-1139, 4, 4398), Mobs = { "Pirate", "Brute", "Bobby", "The Saw" } },
    { Name = "Lv. 60+ | Sa Mạc", Pos = Vector3.new(895, 6, 4389), Mobs = { "Desert Bandit", "Desert Officer" } },
    { Name = "Lv. 90+ | Đảo Tuyết", Pos = Vector3.new(1389, 87, -1298), Mobs = { "Snow Bandit", "Snowman", "Yeti" } },
    { Name = "Lv. 120+ | Marine Ford", Pos = Vector3.new(-4881, 20, 4307), Mobs = { "Chief Petty Officer", "Navy Chief", "Greybeard" } },
    { Name = "Lv. 150+ | Bầu Trời", Pos = Vector3.new(-4842, 717, -2623), Mobs = { "Sky Bandit", "Dark Master", "God's Guard", "Thunder God" } },
    { Name = "Lv. 220+ | Đảo Nhà Tù", Pos = Vector3.new(4875, 5, 739), Mobs = { "Prisoner", "Dangerous Prisoner", "Chief Warden", "Swan" } },
    { Name = "Lv. 275+ | Đấu Trường", Pos = Vector3.new(-1311, 7, -2976), Mobs = { "Toga Warrior", "Gladiator" } },
    { Name = "Lv. 300+ | Magma Village", Pos = Vector3.new(-5316, 12, 8515), Mobs = { "Military Soldier", "Military Spy", "Magma Admiral" } },
    { Name = "Lv. 375+ | Thủy Sái", Pos = Vector3.new(6112, 5, 1567), Mobs = { "Fishman Warrior", "Fishman Commando", "Fishman Lord" } }
}

local function getOrderedMobs()
    local orderedList = {}
    for _, island in ipairs(SEA1_ISLANDS) do
        for _, mob in ipairs(island.Mobs) do
            table.insert(orderedList, { name = mob, island = island.Name, pos = island.Pos })
        end
    end
    return orderedList
end

local S = {
    Enabled = false,
    MobName = nil,
    AutoQuest = true,
    FastAttack = true,
    BringMobs = true,
    Weapon = "Melee",
    Distance = 5, -- Khoảng cách gom quái trước mặt
}

-- Bỏ qua va chạm (Noclip)
track(RunService.Stepped:Connect(function()
    if S.Enabled and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
end))

-- Teleport an toàn bằng Tween (Chống kẹt)
local function tweenTeleport(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - targetPos).Magnitude
    if dist < 200 then
        hrp.CFrame = CFrame.new(targetPos)
    else
        local tweenInfo = TweenInfo.new(dist / 300, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
        tween:Play()
    end
end

-- Lấy vị trí đảo của Mob
local function getIslandPos(mobName)
    for _, item in ipairs(getOrderedMobs()) do
        if item.name == mobName then return item.pos end
    end
    return Vector3.zero
end

-- Nhận Quest an toàn (Không chặn vòng lặp)
local lastQuestAttempt = 0
local function checkAndTakeQuest(mobName)
    if not S.AutoQuest then return false end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local hasQuest = playerGui and playerGui:FindFirstChild("Main") and playerGui.Main:FindFirstChild("Quest") and playerGui.Main.Quest.Visible
    
    if not hasQuest then
        if tick() - lastQuestAttempt > 10 then -- Thử lại sau 10s nếu lỗi
            lastQuestAttempt = tick()
            local islandPos = getIslandPos(mobName)
            if islandPos then
                tweenTeleport(islandPos)
                task.wait(1)
                pcall(function()
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", mobName .. "Quest", 1)
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", mobName, 1)
                end)
            end
        end
        return true -- Đang bận nhận quest
    end
    return false
end

-- Tìm quái vật
local function getEnemies(mobName)
    local list = {}
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        for _, m in ipairs(enemies:GetChildren()) do
            if m.Name == mobName and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 and m:FindFirstChild("HumanoidRootPart") then
                table.insert(list, m)
            end
        end
    end
    return list
end

-- Lõi Farm (Đứng yên + Gom)
local farmCFrame = nil
local currentFarmMob = nil

track(RunService.Heartbeat:Connect(function()
    if not S.Enabled or not S.MobName then 
        farmCFrame = nil
        return 
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Reset bãi farm nếu đổi quái
    if currentFarmMob ~= S.MobName then
        currentFarmMob = S.MobName
        farmCFrame = nil
    end

    -- Nếu đang nhận Quest thì dừng farm
    if checkAndTakeQuest(S.MobName) then return end

    local enemies = getEnemies(S.MobName)

    -- Xác định chỗ đứng cố định (Lấy vị trí con quái đầu tiên tìm được)
    if not farmCFrame then
        if #enemies > 0 then
            farmCFrame = enemies[1].HumanoidRootPart.CFrame + Vector3.new(0, 20, 0) -- Đứng cao hơn 20 studs để an toàn
        else
            -- Chưa thấy quái, bay ra giữa đảo chờ spawn
            tweenTeleport(getIslandPos(S.MobName) + Vector3.new(0, 50, 0))
            return
        end
    end

    -- Khóa vị trí nhân vật tại bãi (Đứng yên)
    if hrp.Position.Y < -500 then hrp.CFrame = farmCFrame end -- Chống rớt map
    tweenTeleport(farmCFrame.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    -- Gom toàn bộ quái lại trước mặt
    if S.BringMobs then
        for _, m in ipairs(enemies) do
            local mHrp = m.HumanoidRootPart
            if mHrp then
                mHrp.CanCollide = false
                mHrp.Size = Vector3.new(10, 10, 10) -- Mở rộng Hitbox
                mHrp.CFrame = hrp.CFrame * CFrame.new(0, -20, -S.Distance) -- Kéo xuống dưới và trước mặt
                mHrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end

    -- Trang bị vũ khí
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t.ToolTip == S.Weapon then
                    char.Humanoid:EquipTool(t)
                    break
                end
            end
        end
    end
end))

-- Redz Fast Attack (Luồng chạy độc lập siêu nhanh)
task.spawn(function()
    while task.wait() do
        if S.Enabled and S.FastAttack then
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    tool:Activate()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end)
            end
        end
    end
end)

-- =====================================================================
-- ===== UI MENU CAO CẤP ===============================================
-- =====================================================================
local CoreGui = game:GetService("CoreGui")
local Gui = Instance.new("ScreenGui")
Gui.Name = "CPZHubV9"
Gui.ResetOnSpawn = false
Gui.Parent = (gethui and gethui()) or CoreGui

local C_BG = Color3.fromRGB(15, 15, 20)
local C_PANEL = Color3.fromRGB(25, 25, 35)
local C_ACCENT = Color3.fromRGB(0, 255, 128)
local C_TEXT = Color3.fromRGB(240, 240, 255)
local C_SUB = Color3.fromRGB(120, 120, 140)

local function mk(class, props, kids)
    local i = Instance.new(class)
    if i:IsA("GuiObject") then i.BorderSizePixel = 0 end
    for k, v in pairs(props) do i[k] = v end
    for _, c in ipairs(kids or {}) do c.Parent = i end
    return i
end
local function round(r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }) end

local Main = mk("Frame", {
    Parent = Gui, Size = UDim2.fromOffset(360, 480), Position = UDim2.new(0.5, -180, 0.5, -240), BackgroundColor3 = C_BG, Active = true, Draggable = true
}, { round(10), mk("UIStroke", { Color = C_ACCENT, Thickness = 1.5 }) })

mk("TextLabel", {
    Parent = Main, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 15, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "Blox Fruits V9 (Redz Gom Quái)", TextSize = 14, TextColor3 = C_ACCENT, TextXAlignment = Enum.TextXAlignment.Left
})

local closeBtn = mk("TextButton", {
    Parent = Main, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(1, -40, 0, 5), BackgroundColor3 = C_PANEL, Font = Enum.Font.GothamBold, Text = "X", TextSize = 12, TextColor3 = C_TEXT, AutoButtonColor = false
}, { round(8) })
closeBtn.MouseButton1Click:Connect(function() if env.BFFarmCleanup then env.BFFarmCleanup() end end)

local Scroll = mk("ScrollingFrame", {
    Parent = Main, Size = UDim2.new(1, -20, 1, -60), Position = UDim2.new(0, 10, 0, 50), BackgroundTransparency = 1, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3
}, { mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }) })

local function addToggle(title, get, set)
    local f = mk("TextButton", { Parent = Scroll, Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = C_PANEL, Font = Enum.Font.GothamSemibold, Text = "  " .. title, TextSize = 12, TextColor3 = C_TEXT, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false }, { round(6) })
    local status = mk("TextLabel", { Parent = f, Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(1, -60, 0, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "", TextSize = 12 })
    local function render()
        status.Text = get() and "BẬT" or "TẮT"
        status.TextColor3 = get() and C_ACCENT or C_SUB
    end
    f.MouseButton1Click:Connect(function() set(not get()) render() end)
    render()
    return f
end

addToggle("⚡ AUTO FARM", function() return S.Enabled end, function(v) 
    S.Enabled = v
    if not v then farmCFrame = nil end 
end)
addToggle("Nhận Quest Tự Động", function() return S.AutoQuest end, function(v) S.AutoQuest = v end)
addToggle("Redz Fast Attack", function() return S.FastAttack end, function(v) S.FastAttack = v end)
addToggle("Gom Quái (Bring Mobs)", function() return S.BringMobs end, function(v) S.BringMobs = v end)

mk("TextLabel", { Parent = Scroll, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "CHỌN QUÁI (Theo thứ tự đảo):", TextSize = 12, TextColor3 = C_ACCENT, TextXAlignment = Enum.TextXAlignment.Left })

local mobButtons = {}
local function updateMobList()
    for _, b in pairs(mobButtons) do b.BackgroundColor3 = (S.MobName == b.Name) and C_ACCENT or C_PANEL; b.TextColor3 = (S.MobName == b.Name) and C_BG or C_TEXT end
end

for _, item in ipairs(getOrderedMobs()) do
    local btn = mk("TextButton", {
        Parent = Scroll, Name = item.name, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C_PANEL, Font = Enum.Font.Gotham, Text = string.format("  ⚔️ %s (%s)", item.name, item.island), TextSize = 11, TextColor3 = C_TEXT, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false
    }, { round(6) })
    btn.MouseButton1Click:Connect(function()
        S.MobName = (S.MobName == item.name) and nil or item.name
        farmCFrame = nil -- Reset chỗ đứng
        updateMobList()
    end)
    table.insert(mobButtons, btn)
end

env.BFFarmCleanup = function()
    S.Enabled = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    pcall(function() Gui:Destroy() end)
    env.BFFarmCleanup = nil
end
