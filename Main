local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isAutoBlockEnabled = false
local blockDistance = 20
local isBlocking = false
local lastAttackTime = 0
local lockedTarget = nil

-- Tạo Cyberpunk Highlight
local cyberHighlight = Instance.new("Highlight")
cyberHighlight.Name = "CyberpunkTarget"
cyberHighlight.FillColor = Color3.fromRGB(255, 0, 128) -- Hồng Neon
cyberHighlight.OutlineColor = Color3.fromRGB(0, 255, 255) -- Xanh Cyan
cyberHighlight.FillTransparency = 0.5
cyberHighlight.OutlineTransparency = 0
cyberHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        lastAttackTime = tick()
    end
end)

local blockService = ReplicatedStorage:WaitForChild("Knit", 10)
if blockService then
    blockService = blockService:WaitForChild("Knit", 10):WaitForChild("Services", 10):WaitForChild("BlockService", 10):WaitForChild("RE", 10)
end

local activatedRemote = blockService and blockService:FindFirstChild("Activated")
local deactivatedRemote = blockService and blockService:FindFirstChild("Deactivated")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoBlock_ModernUI"
ScreenGui.ResetOnSpawn = false
if not pcall(function() ScreenGui.Parent = CoreGui end) then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 185) -- Tăng chiều cao chứa nút Lock
MainFrame.Position = UDim2.new(0.5, -100, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(60, 60, 60)

local TopBar = Instance.new("TextLabel")
TopBar.Size = UDim2.new(1, 0, 0, 30)
TopBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TopBar.Text = "  AUTO BLOCK V2"
TopBar.TextColor3 = Color3.fromRGB(255, 255, 255)
TopBar.Font = Enum.Font.GothamBold
TopBar.TextSize = 14
TopBar.TextXAlignment = Enum.TextXAlignment.Left
TopBar.Parent = MainFrame
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 10)

Instance.new("Frame", TopBar).Size = UDim2.new(1, 0, 0, 10)
TopBar:GetChildren()[2].Position = UDim2.new(0, 0, 1, -10)
TopBar:GetChildren()[2].BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TopBar:GetChildren()[2].BorderSizePixel = 0

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.85, 0, 0, 30)
ToggleBtn.Position = UDim2.new(0.075, 0, 0.22, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
ToggleBtn.Text = "STATUS: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextSize = 13
ToggleBtn.Parent = MainFrame
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

-- Nút Khóa Mục Tiêu
local LockBtn = Instance.new("TextButton")
LockBtn.Size = UDim2.new(0.85, 0, 0, 30)
LockBtn.Position = UDim2.new(0.075, 0, 0.42, 0)
LockBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
LockBtn.Text = "LOCK: NONE"
LockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
LockBtn.Font = Enum.Font.GothamBold
LockBtn.TextSize = 13
LockBtn.Parent = MainFrame
Instance.new("UICorner", LockBtn).CornerRadius = UDim.new(0, 6)

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0.62, 0)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "System: Idle"
StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
StatusLabel.Font = Enum.Font.GothamSemibold
StatusLabel.TextSize = 12
StatusLabel.Parent = MainFrame

local DistanceLabel = Instance.new("TextLabel")
DistanceLabel.Size = UDim2.new(1, 0, 0, 20)
DistanceLabel.Position = UDim2.new(0, 0, 0.75, 0)
DistanceLabel.BackgroundTransparency = 1
DistanceLabel.Text = "Range: " .. blockDistance
DistanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
DistanceLabel.Font = Enum.Font.Gotham
DistanceLabel.TextSize = 12
DistanceLabel.Parent = MainFrame

local SliderBg = Instance.new("Frame")
SliderBg.Size = UDim2.new(0.85, 0, 0, 8)
SliderBg.Position = UDim2.new(0.075, 0, 0.88, 0)
SliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SliderBg.Parent = MainFrame
Instance.new("UICorner", SliderBg).CornerRadius = UDim.new(0, 4)

local SliderFill = Instance.new("Frame")
SliderFill.Size = UDim2.new((blockDistance - 3) / 37, 0, 1, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(0, 255, 255) -- Cyan
SliderFill.Parent = SliderBg
Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(0, 4)

ToggleBtn.MouseButton1Click:Connect(function()
    isAutoBlockEnabled = not isAutoBlockEnabled
    ToggleBtn.BackgroundColor3 = isAutoBlockEnabled and Color3.fromRGB(50, 200, 80) or Color3.fromRGB(220, 50, 50)
    ToggleBtn.Text = isAutoBlockEnabled and "STATUS: ON" or "STATUS: OFF"
end)

local function getRootPart(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Logic Khóa mục tiêu gần nhất
LockBtn.MouseButton1Click:Connect(function()
    if lockedTarget then
        lockedTarget = nil
        cyberHighlight.Parent = nil
        LockBtn.Text = "LOCK: NONE"
        LockBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    else
        local myChar = LocalPlayer.Character
        local myRoot = getRootPart(myChar)
        if not myRoot then return end

        local closest = nil
        local shortest = math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local root = getRootPart(player.Character)
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = player.Character
                    end
                end
            end
        end

        if closest then
            lockedTarget = closest
            cyberHighlight.Parent = closest
            LockBtn.Text = "LOCKED: " .. closest.Name
            LockBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 128) -- Đổi màu nút sang Hồng Neon
        end
    end
end)

local isDraggingSlider = false
local function updateSlider(input)
    local percentage = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    blockDistance = math.floor(3 + 37 * percentage)
    DistanceLabel.Text = "Range: " .. blockDistance
end

SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true; updateSlider(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

local draggingUI, dragStart, startPos = false, nil, nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingUI = true; dragStart = input.Position; startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingUI and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
TopBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingUI = false end
end)

local function lookAtTarget(targetPart)
    local char = LocalPlayer.Character
    local myRoot = getRootPart(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if myRoot and targetPart then
        if hum then hum.AutoRotate = false end
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(targetPart.Position.X, myRoot.Position.Y, targetPart.Position.Z))
        task.delay(0.4, function() if hum then hum.AutoRotate = true end end)
    end
end

local function triggerBlock()
    if not activatedRemote or not deactivatedRemote then
        StatusLabel.Text = "System: Missing Remote"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return false
    end
    local success = pcall(function() activatedRemote:FireServer() end)
    if success then
        StatusLabel.Text = "System: BLOCKED!"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
        task.delay(0.4, function()
            pcall(function() deactivatedRemote:FireServer() end)
            StatusLabel.Text = "System: Idle"
            StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end)
        return true
    end
    return false
end

local function setupRemoteListener(remote)
    if not remote:IsA("RemoteEvent") then return end
    if remote == activatedRemote or remote == deactivatedRemote then return end
    if remote.Name:lower():find("emote") then return end

    remote.OnClientEvent:Connect(function(...)
        if not isAutoBlockEnabled or isBlocking then return end
        if tick() - lastAttackTime < 0.3 then return end

        local myChar = LocalPlayer.Character
        local myRoot = getRootPart(myChar)
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not myRoot or not myHum or myHum.Health <= 0 then return end

        local args = {...}
        local primaryActor = nil
        for _, arg in ipairs(args) do
            if typeof(arg) == "Instance" then
                local model = arg:IsA("Model") and arg or arg:FindFirstAncestorOfClass("Model")
                if model and model:FindFirstChildOfClass("Humanoid") then
                    primaryActor = model
                    break
                end
            end
        end

        if primaryActor == myChar or (primaryActor and primaryActor.Name == LocalPlayer.Name) then return end

        -- NẾU CÓ LOCKED TARGET, CHỈ PHẢN ỨNG VỚI TARGET ĐÓ
        if lockedTarget then
            if primaryActor ~= lockedTarget then return end
        end

        local closestTarget = nil
        local shortestDistance = blockDistance

        for _, arg in ipairs(args) do
            if typeof(arg) == "Instance" then
                local model = arg:IsA("Model") and arg or arg:FindFirstAncestorOfClass("Model")
                
                if model and model ~= myChar and model.Name ~= LocalPlayer.Name then
                    -- NẾU CÓ LOCKED TARGET, BỎ QUA CÁC MODEL KHÁC
                    if lockedTarget and model ~= lockedTarget then continue end

                    local hum = model:FindFirstChildOfClass("Humanoid")
                    local root = getRootPart(model)
                    
                    if hum and root and hum.Health > 0 then
                        local state = hum:GetState()
                        local isRagdoll = hum.PlatformStand or hum.Sit or 
                                          state == Enum.HumanoidStateType.Physics or 
                                          state == Enum.HumanoidStateType.Dead or 
                                          state == Enum.HumanoidStateType.Ragdoll or
                                          state == Enum.HumanoidStateType.FallingDown
                        
                        if not isRagdoll then
                            local dist = (myRoot.Position - root.Position).Magnitude
                            if dist <= shortestDistance then
                                shortestDistance = dist
                                closestTarget = root
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            isBlocking = true
            lookAtTarget(closestTarget)
            triggerBlock()
            task.delay(0.4, function() isBlocking = false end)
        end
    end)
end

for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    setupRemoteListener(obj)
end
ReplicatedStorage.DescendantAdded:Connect(setupRemoteListener)

-- Giữ Highlight dính chặt nếu mục tiêu respawn
RunService.Heartbeat:Connect(function()
    if lockedTarget and cyberHighlight.Parent ~= lockedTarget then
        if lockedTarget.Parent then
            cyberHighlight.Parent = lockedTarget
        else
            lockedTarget = nil
            LockBtn.Text = "LOCK: NONE"
            LockBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        end
    end
end)
